# Copier vers .env, ou laisser scripts/project.py setup le créer.
# Ne jamais ajouter .env ou .Secrets à Git. Ne pas partager les clés avec le jury.
# Priorité AppSettings : environnement > .Secrets > .env.

# Minimum pour tester en mode Texte : une clé OpenAI avec accès aux modèles indiqués.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_RESEARCH_MODEL="gpt-5-mini"

# Voix principale : Gradium. OpenAI est disponible en repli si configuré.
GRADIUM_API_KEY=""
GRADIUM_VOICE_ID="b35yykvVppLXyw_l"
GRADIUM_STT_DELAY_FRAMES=16
GRADIUM_STT_LANGUAGE="fr"
# "any" pour une réunion multilingue : transcription, sans traduction.

# Connecteurs facultatifs : laisser vide si non utilisés.
DUST_API_KEY=""
DUST_WORKSPACE_ID=""
DUST_DOMAIN="https://dust.tt"
# Workspace européen : https://eu.dust.tt
PIPELEX_API_KEY=""
TYPESAFE_API_KEY=""
EXA_API_KEY=""
JINKO_API_KEY=""
# Sans TypeSafe, le modèle configuré assure le routage.
